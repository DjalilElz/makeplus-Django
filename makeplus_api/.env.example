# Django Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
# Use Supabase database (True) or local SQLite (False)
USE_SUPABASE=False

# Supabase Database Configuration (Session Pooler for Render - IPv4 compatible)
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=your-supabase-user
SUPABASE_DB_PASSWORD=your-supabase-password
SUPABASE_DB_HOST=your-supabase-host
SUPABASE_DB_PORT=6543

# Supabase API Keys
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_KEY=your_service_key_here

ALLOWED_HOSTS=localhost,127.0.0.1,*.ngrok.io

# Postmark Email Configuration
POSTMARK_SERVER_TOKEN=your-postmark-server-api-token-here
POSTMARK_MESSAGE_STREAM=outbound
# Optional: protects /track/postmark/webhook/ with HTTP Basic Auth --
# set the same values on the webhook URL in Postmark's dashboard
POSTMARK_WEBHOOK_USERNAME=
POSTMARK_WEBHOOK_PASSWORD=
DEFAULT_FROM_EMAIL=your-verified-sender@example.com
SITE_URL=http://127.0.0.1:8000

# FTP Storage Configuration (for persistent file storage)
USE_FTP_STORAGE=False
FTP_HOST=ftp.wemakeplus.com
FTP_USER=wemaszv1
FTP_PASSWORD=your-ftp-password-here
FTP_PORT=21
FTP_DOMAIN=wemakeplus.com
FTP_PATH=/home/wemaszvr/wemakeplus.com/makeplus-media
